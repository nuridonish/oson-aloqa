# ===== Oson Aloqa v3 — Full Stack =====
# Копия кунед ба .env ва қиматҳоро иваз кунед

PORT=8080
NODE_ENV=production

PGHOST=postgres
PGPORT=5432
PGUSER=osonaloqa
PGPASSWORD=CHANGE_ME_strong_password
PGDATABASE=osonaloqa

JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=7776000

SMS_PROVIDER=none
SMS_API_KEY=
SMS_FROM=
SMS_URL_TEMPLATE=

CORS_ORIGINS=*
MEDIA_DIR=/data/uploads
MEDIA_MAX_MB=25

FCM_CREDENTIALS_FILE=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio

TLS_CERT=
TLS_KEY=
